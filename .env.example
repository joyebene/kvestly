# ───────────────────────── KVESTY environment variables ─────────────────────────
# NEVER commit real values. Copy to .env.local for development; set the production
# values in your hosting provider's secret store (Vercel / Cloudflare), not in git.

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated origins allowed to call state-changing API routes (CSRF origin check)
ALLOWED_ORIGINS=http://localhost:3000

# ── MongoDB (MongoDB Atlas recommended; enable IP allow-list + TLS + backups) ──
MONGODB_URI=
MONGODB_DB=kvesty

# ── Auth / crypto (generate each with: openssl rand -base64 32) ──
AUTH_SECRET=
# 32-byte key, base64 — encrypts TOTP secrets at rest (AES-256-GCM)
MFA_ENCRYPTION_KEY=
# Used to HMAC IP addresses/emails in rate-limit keys so raw values aren't stored
RATE_LIMIT_SALT=

# ── Cloudflare Turnstile ──
# Dev test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only honour CF-Connecting-IP when the origin is reachable ONLY through Cloudflare
TRUST_CLOUDFLARE_HEADERS=false

# ── Feature flags (all financial features are OFF until verified providers exist) ──
FEATURE_REGISTRATION=true
FEATURE_KYC=false
FEATURE_FUNDING_REQUESTS=false
# Demo environment at /demo shows clearly-labelled sample data. Disable in production.
FEATURE_DEMO_ENVIRONMENT=true

# ── Company details — leave blank until verified. Nothing is invented. ──
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_REG_NUMBER=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_REGULATOR_NAME=
NEXT_PUBLIC_REGULATOR_LICENCE_NUMBER=
NEXT_PUBLIC_REGULATOR_STATUS_URL=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TELEGRAM=

# ── Email provider (not wired yet — see docs/ARCHITECTURE.md "Integrations to supply") ──
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
CONTACT_INBOX_EMAIL=

# ── Object storage for KYC documents (not wired yet; use private, encrypted bucket e.g. Cloudflare R2) ──
KYC_STORAGE_BUCKET=
KYC_STORAGE_ACCESS_KEY_ID=
KYC_STORAGE_SECRET_ACCESS_KEY=



NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_IPN_URL=https://yourdomain.com/api/webhooks/nowpayments

INVESTMENT_PAYMENT_EXPIRY_MINUTES=60